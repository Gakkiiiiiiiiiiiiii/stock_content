{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-knowledge-bundle.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "canonicalization_version", "bundle_id", "bundle_hash", "request", "request_hash", "content_snapshot_id", "query", "scope", "source", "business_as_of", "knowledge_as_of", "availability_as_of", "items", "quality", "producer"],
  "properties": {
    "contract": {"const": "content-knowledge-bundle.v2"},
    "schema_version": {"const": "2.0.0"},
    "canonicalization_version": {"const": "content-bundle-c14n-v2"},
    "bundle_id": {"type": "string", "pattern": "^ckb_[a-f0-9]{64}$"},
    "bundle_hash": {"$ref": "#/$defs/hash"},
    "request_hash": {"$ref": "#/$defs/hash"},
    "content_snapshot_id": {"$ref": "#/$defs/non_empty"},
    "query": {"$ref": "#/$defs/non_empty"},
    "request": {"$ref": "#/$defs/request"},
    "scope": {"$ref": "#/$defs/scope"},
    "source": {"$ref": "#/$defs/source"},
    "business_as_of": {"$ref": "#/$defs/instant"},
    "knowledge_as_of": {"$ref": "#/$defs/instant"},
    "availability_as_of": {"$ref": "#/$defs/instant"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "quality": {"$ref": "#/$defs/quality"},
    "producer": {"$ref": "#/$defs/producer"}
  },
  "$defs": {
    "non_empty": {"type": "string", "minLength": 1},
    "instant": {"type": "string", "format": "date-time"},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9A-F]{64}$"},
    "nullable_string": {"type": ["string", "null"]},
    "request": {"type": "object", "additionalProperties": false, "required": ["content_snapshot_id", "query", "symbol", "business_as_of", "knowledge_as_of", "availability_as_of", "minimum_support_status", "max_items", "policy", "policy_version", "contract_version", "subject_scope"], "properties": {"content_snapshot_id": {"$ref": "#/$defs/non_empty"}, "query": {"$ref": "#/$defs/non_empty"}, "symbol": {"$ref": "#/$defs/non_empty"}, "business_as_of": {"$ref": "#/$defs/instant"}, "knowledge_as_of": {"$ref": "#/$defs/instant"}, "availability_as_of": {"$ref": "#/$defs/instant"}, "minimum_support_status": {"$ref": "#/$defs/non_empty"}, "max_items": {"type": "integer", "minimum": 1, "maximum": 100}, "policy": {"const": "PUBLIC_STRICT"}, "policy_version": {"$ref": "#/$defs/non_empty"}, "contract_version": {"const": "content-knowledge-bundle.v2"}, "subject_scope": {"enum": ["SUBJECT_ONLY", "ALL_SUBJECTS"]}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["subject_scope", "requested_subject"], "properties": {"subject_scope": {"enum": ["SUBJECT_ONLY", "ALL_SUBJECTS"]}, "requested_subject": {"type": ["string", "null"]}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["source_type", "source_identity_hash", "source_version_id", "canonical_url", "source_content_hash"], "properties": {"source_type": {"$ref": "#/$defs/non_empty"}, "source_identity_hash": {"$ref": "#/$defs/non_empty"}, "source_version_id": {"$ref": "#/$defs/non_empty"}, "canonical_url": {"type": "string", "format": "uri"}, "title": {"$ref": "#/$defs/non_empty"}, "author": {"$ref": "#/$defs/non_empty"}, "published_at": {"$ref": "#/$defs/instant"}, "source_content_hash": {"$ref": "#/$defs/non_empty"}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["knowledge_id", "claim_id", "occurrence_id", "statement", "subject", "predicate", "object", "primary_domain", "claim_nature", "attribution", "source_grade", "detail", "temporal", "evidence", "occurrence_review", "support_status", "lifecycle_status", "verification", "external_truth_status", "grounding_status"], "properties": {"knowledge_id": {"$ref": "#/$defs/non_empty"}, "claim_id": {"$ref": "#/$defs/non_empty"}, "occurrence_id": {"$ref": "#/$defs/non_empty"}, "statement": {"$ref": "#/$defs/non_empty"}, "subject": {"$ref": "#/$defs/subject"}, "predicate": {"$ref": "#/$defs/non_empty"}, "object": {"$ref": "#/$defs/object"}, "condition": {"$ref": "#/$defs/nullable_string"}, "invalidation": {"$ref": "#/$defs/nullable_string"}, "primary_domain": {"enum": ["PORTFOLIO_RISK_MANAGEMENT", "FINANCIAL_SECTOR_CAPITAL_POLICY", "AI_INFERENCE_COMPUTE", "INFORMATION_INFRASTRUCTURE_POLICY", "CENTRAL_BANK_GOLD_RESERVES", "UNKNOWN"]}, "claim_nature": {"$ref": "#/$defs/non_empty"}, "attribution": {"$ref": "#/$defs/attribution"}, "source_grade": {"enum": ["PRIMARY", "SECONDARY", "SOURCE_ASSERTION", "UNKNOWN"]}, "detail": {"$ref": "#/$defs/detail"}, "temporal": {"$ref": "#/$defs/temporal"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "occurrence_review": {"$ref": "#/$defs/review"}, "support_status": {"$ref": "#/$defs/non_empty"}, "lifecycle_status": {"const": "ACTIVE"}, "confidence": {"type": ["number", "null"]}, "verification": {"$ref": "#/$defs/verification"}, "external_truth_status": {"enum": ["NOT_CHECKED", "NOT_FOUND", "EXTERNALLY_VERIFIED", "EXTERNAL_CONFLICT"]}, "contradiction_group_id": {"type": ["string", "null"]}, "grounding_status": {"const": "GROUNDED"}}},
    "subject": {"type": "object", "additionalProperties": false, "required": ["type", "key"], "properties": {"type": {"$ref": "#/$defs/non_empty"}, "key": {"$ref": "#/$defs/non_empty"}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"type": ["string", "number", "boolean", "null"]}, "unit": {"type": ["string", "null"]}}},
    "attribution": {"type": "object", "additionalProperties": false, "required": ["attributed", "source_label"], "properties": {"attributed": {"type": "boolean"}, "source_label": {"type": ["string", "null"]}, "speaker": {"type": ["string", "null"]}}},
    "detail": {"type": "object", "additionalProperties": false, "properties": {"explanation": {"$ref": "#/$defs/nullable_string"}, "mechanism": {"$ref": "#/$defs/nullable_string"}, "procedure": {"$ref": "#/$defs/nullable_string"}, "formula": {"$ref": "#/$defs/nullable_string"}, "example": {"$ref": "#/$defs/nullable_string"}, "scope": {"$ref": "#/$defs/nullable_string"}, "risks": {"$ref": "#/$defs/nullable_string"}}},
    "temporal": {"type": "object", "additionalProperties": false, "required": ["kind", "start", "end", "as_of", "rule", "label", "precision", "explicitly_unknown"], "properties": {"kind": {"enum": ["EVENT", "AS_OF", "FORECAST_TARGET", "RECURRING_RULE", "UNKNOWN"]}, "start": {"type": ["string", "null"], "format": "date-time"}, "end": {"type": ["string", "null"], "format": "date-time"}, "as_of": {"type": ["string", "null"], "format": "date-time"}, "rule": {"type": ["string", "null"]}, "label": {"type": ["string", "null"]}, "precision": {"$ref": "#/$defs/non_empty"}, "explicitly_unknown": {"type": "boolean"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "ownership", "modality", "artifact_id", "artifact_hash", "locator", "content"], "properties": {"evidence_id": {"$ref": "#/$defs/non_empty"}, "ownership": {"enum": ["PRIMARY", "SECONDARY"]}, "modality": {"enum": ["transcript", "frame", "ocr", "vision"]}, "artifact_id": {"$ref": "#/$defs/non_empty"}, "artifact_hash": {"$ref": "#/$defs/hash"}, "locator": {"$ref": "#/$defs/locator"}, "content": {"$ref": "#/$defs/non_empty"}, "model": {"$ref": "#/$defs/model"}}},
    "locator": {"type": "object", "additionalProperties": false, "required": ["segment_id", "frame_id", "start_ms", "end_ms", "bbox"], "properties": {"segment_id": {"type": ["string", "null"]}, "frame_id": {"type": ["string", "null"]}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 0}, "bbox": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 4, "maxItems": 4}}},
    "model": {"type": "object", "additionalProperties": false, "required": ["name", "version", "confidence"], "properties": {"name": {"$ref": "#/$defs/non_empty"}, "version": {"$ref": "#/$defs/non_empty"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["status", "reason_codes"], "properties": {"status": {"enum": ["NOT_REQUIRED", "HUMAN_REVIEW_REQUIRED", "REVIEWED"]}, "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/non_empty"}}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["status", "reason_codes"], "properties": {"status": {"$ref": "#/$defs/non_empty"}, "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/non_empty"}}}},
    "quality": {"type": "object", "additionalProperties": false, "required": ["candidate_count", "eligible_candidate_count", "excluded_candidate_count", "truncated_candidate_count", "knowledge_count", "grounded_count", "numeric_candidate_count", "numeric_grounded_count", "human_review_required_count", "conflict_count", "secondary_only_count", "external_truth_not_checked_count", "grounded_ratio", "numeric_grounded_ratio", "warnings"], "properties": {"candidate_count": {"type": "integer", "minimum": 0}, "eligible_candidate_count": {"type": "integer", "minimum": 0}, "excluded_candidate_count": {"type": "integer", "minimum": 0}, "truncated_candidate_count": {"type": "integer", "minimum": 0}, "knowledge_count": {"type": "integer", "minimum": 0}, "grounded_count": {"type": "integer", "minimum": 0}, "numeric_candidate_count": {"type": "integer", "minimum": 0}, "numeric_grounded_count": {"type": "integer", "minimum": 0}, "human_review_required_count": {"type": "integer", "minimum": 0}, "conflict_count": {"type": "integer", "minimum": 0}, "secondary_only_count": {"type": "integer", "minimum": 0}, "external_truth_not_checked_count": {"type": "integer", "minimum": 0}, "grounded_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "numeric_grounded_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "transcript_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/non_empty"}}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["service", "service_version", "git_commit", "pipeline_version", "contract_checksum"], "properties": {"service": {"const": "stock_content"}, "service_version": {"$ref": "#/$defs/non_empty"}, "git_commit": {"$ref": "#/$defs/non_empty"}, "pipeline_version": {"$ref": "#/$defs/non_empty"}, "contract_checksum": {"type": "string", "pattern": "^sha256:[A-F0-9]{64}$"}}}
  }
}
