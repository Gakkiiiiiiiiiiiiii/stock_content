{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-knowledge-bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "schema_version", "canonicalization_version", "bundle_id", "bundle_hash", "request", "request_hash", "content_snapshot_id", "query", "source", "business_as_of", "knowledge_as_of", "availability_as_of", "items", "quality", "producer"],
  "properties": {
    "contract": {"const": "content-knowledge-bundle.v1"},
    "schema_version": {"const": "1.0.0"},
    "canonicalization_version": {"const": "content-bundle-c14n-v1"},
    "bundle_id": {"type": "string", "pattern": "^ckb_[a-f0-9]{64}$"},
    "bundle_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "request_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "content_snapshot_id": {"type": "string", "minLength": 1}, "query": {"type": "string", "minLength": 1},
    "business_as_of": {"type": "string", "format": "date-time"}, "knowledge_as_of": {"type": "string", "format": "date-time"}, "availability_as_of": {"type": "string", "format": "date-time"},
    "request": {"$ref": "#/$defs/request"}, "source": {"$ref": "#/$defs/source"}, "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}, "quality": {"$ref": "#/$defs/quality"}, "producer": {"$ref": "#/$defs/producer"}
  },
  "$defs": {
    "instant": {"type": "string", "format": "date-time"}, "non_empty": {"type": "string", "minLength": 1},
    "request": {"type": "object", "additionalProperties": false, "required": ["content_snapshot_id", "query", "symbol", "business_as_of", "knowledge_as_of", "availability_as_of", "minimum_support_status", "max_items", "policy", "policy_version"], "properties": {"content_snapshot_id": {"$ref": "#/$defs/non_empty"}, "query": {"$ref": "#/$defs/non_empty"}, "symbol": {"$ref": "#/$defs/non_empty"}, "business_as_of": {"$ref": "#/$defs/instant"}, "knowledge_as_of": {"$ref": "#/$defs/instant"}, "availability_as_of": {"$ref": "#/$defs/instant"}, "minimum_support_status": {"$ref": "#/$defs/non_empty"}, "max_items": {"type": "integer", "minimum": 1, "maximum": 100}, "policy": {"const": "PUBLIC_STRICT"}, "policy_version": {"$ref": "#/$defs/non_empty"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["source_type", "source_identity_hash", "source_version_id", "canonical_url", "source_content_hash"], "properties": {"source_type": {"$ref": "#/$defs/non_empty"}, "source_identity_hash": {"$ref": "#/$defs/non_empty"}, "source_version_id": {"$ref": "#/$defs/non_empty"}, "canonical_url": {"type": "string", "format": "uri"}, "title": {"$ref": "#/$defs/non_empty"}, "author": {"$ref": "#/$defs/non_empty"}, "published_at": {"$ref": "#/$defs/instant"}, "source_content_hash": {"$ref": "#/$defs/non_empty"}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["knowledge_id", "claim_id", "occurrence_id", "statement", "subject", "predicate", "object", "support_status", "lifecycle_status", "temporal", "evidence", "verification", "grounding_status"], "properties": {"knowledge_id": {"$ref": "#/$defs/non_empty"}, "claim_id": {"$ref": "#/$defs/non_empty"}, "occurrence_id": {"$ref": "#/$defs/non_empty"}, "statement": {"$ref": "#/$defs/non_empty"}, "subject": {"$ref": "#/$defs/subject"}, "predicate": {"$ref": "#/$defs/non_empty"}, "object": {"$ref": "#/$defs/object"}, "condition": {"type": ["string", "null"]}, "invalidation": {"type": ["string", "null"]}, "support_status": {"$ref": "#/$defs/non_empty"}, "lifecycle_status": {"const": "ACTIVE"}, "confidence": {"type": ["number", "null"]}, "temporal": {"$ref": "#/$defs/temporal"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "verification": {"$ref": "#/$defs/verification"}, "contradiction_group_id": {"type": ["string", "null"]}, "grounding_status": {"const": "GROUNDED"}}},
    "subject": {"type": "object", "additionalProperties": false, "required": ["type", "key"], "properties": {"type": {"$ref": "#/$defs/non_empty"}, "key": {"$ref": "#/$defs/non_empty"}}},
    "json_scalar": {"type": ["string", "number", "boolean", "null"]},
    "object": {"type": "object", "additionalProperties": false, "required": ["value", "unit"], "properties": {"value": {"$ref": "#/$defs/json_scalar"}, "unit": {"type": ["string", "null"]}}},
    "temporal": {"type": "object", "additionalProperties": false, "required": ["target_start", "target_end", "precision"], "properties": {"target_start": {"$ref": "#/$defs/instant"}, "target_end": {"$ref": "#/$defs/instant"}, "precision": {"$ref": "#/$defs/non_empty"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "ownership", "artifact_id", "segment_id", "start_ms", "end_ms", "quote", "quote_hash", "modality"], "properties": {"evidence_id": {"$ref": "#/$defs/non_empty"}, "ownership": {"enum": ["PRIMARY", "SECONDARY"]}, "artifact_id": {"$ref": "#/$defs/non_empty"}, "segment_id": {"$ref": "#/$defs/non_empty"}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 0}, "quote": {"$ref": "#/$defs/non_empty"}, "quote_hash": {"$ref": "#/$defs/non_empty"}, "modality": {"$ref": "#/$defs/non_empty"}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["status", "reason_codes"], "properties": {"status": {"$ref": "#/$defs/non_empty"}, "reason_codes": {"type": "array", "items": {"$ref": "#/$defs/non_empty"}}}},
    "quality": {"type": "object", "additionalProperties": false, "required": ["knowledge_count", "grounded_ratio", "numeric_grounded_ratio", "warnings"], "properties": {"knowledge_count": {"type": "integer", "minimum": 0}, "grounded_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "numeric_grounded_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "transcript_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/non_empty"}}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["service", "service_version", "git_commit", "pipeline_version", "contract_checksum"], "properties": {"service": {"const": "stock_content"}, "service_version": {"$ref": "#/$defs/non_empty"}, "git_commit": {"$ref": "#/$defs/non_empty"}, "pipeline_version": {"$ref": "#/$defs/non_empty"}, "contract_checksum": {"type": "string", "pattern": "^sha256:[A-F0-9]{64}$"}}}
  }
}
