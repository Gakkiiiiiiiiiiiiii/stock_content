CONTENT_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/stock_content
CONTENT_QDRANT_URL=http://qdrant:6333
CONTENT_QDRANT_COLLECTION=stock_content_knowledge_v1
CONTENT_SERVICE_PORT=8100
CONTENT_ASR_MODEL=small
CONTENT_TASK_LEASE_SECONDS=900
CONTENT_WORKER_POLL_SECONDS=2
# 详细修改方案：快照/核验/向量重建身份变量
CONTENT_GIT_COMMIT=unknown
CONTENT_EXTERNAL_FACT_PROVIDER=http
# Verification worker（§5 P1-2）
VERIFICATION_POLL_SECONDS=30
# 向量重建清单（§5 P1-6）
CONTENT_EMBEDDING_MODEL=content-embedding.v1
CONTENT_EMBEDDING_VERSION=1
CONTENT_CHUNK_VERSION=chunk.v1
